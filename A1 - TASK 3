import java.util.Arrays;

public class Task03_ParkingAllocation {

    static String[][] slots = {
        new String[2],
        new String[1]
    };

    static int[] allocate(String vehicleNo) {
        for (int i = 0; i < slots.length; i++) {
            for (int j = 0; j < slots[i].length; j++) {
                if (slots[i][j] == null) {
                    slots[i][j] = vehicleNo;
                    return new int[]{i, j};
                }
            }
        }
        return null;
    }

    static boolean release(int floor, int slot) {
        if (floor < 0 || floor >= slots.length ||
            slot < 0 || slot >= slots[floor].length ||
            slots[floor][slot] == null) {
            return false;
        }

        slots[floor][slot] = null;
        return true;
    }

    public static void main(String[] args) {
        System.out.println(Arrays.toString(allocate("TN01")));
        System.out.println(Arrays.toString(allocate("TN02")));
        System.out.println(Arrays.toString(allocate("TN03")));
        System.out.println(allocate("TN04"));

        System.out.println(release(0, 1));
        System.out.println(release(0, 1));
        System.out.println(release(5, 0));

        System.out.println(Arrays.toString(allocate("TN05")));
    }
}
