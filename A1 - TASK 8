
import java.time.LocalTime;
import java.time.Duration;

interface Chargeable {
    double chargingFee(int kWh);
}

abstract class Vehicle {
    private final String regNo;

    Vehicle(String regNo) {
        this.regNo = regNo;
    }

    public String getRegNo() {
        return regNo;
    }

    protected abstract double ratePerHour();

    // Method overloading: using minutes
    public double calculateFee(int minutes) {
        if (minutes < 0)
            throw new IllegalArgumentException("Invalid duration");

        int hours = minutes / 60;
        if (minutes % 60 != 0) hours++;

        return hours * ratePerHour();
    }

    // Method overloading: using entry and exit time
    public double calculateFee(LocalTime in, LocalTime out) {
        long minutes = Duration.between(in, out).toMinutes();
        if (minutes < 0) minutes += 1440;
        return calculateFee((int) minutes);
    }

    @Override
    public boolean equals(Object obj) {
        if (!(obj instanceof Vehicle)) return false;
        Vehicle other = (Vehicle) obj;
        return regNo.equals(other.regNo);
    }

    @Override
    public int hashCode() {
        return regNo.hashCode();
    }
}

class TwoWheeler extends Vehicle {
    TwoWheeler(String regNo) {
        super(regNo);
    }

    @Override
    protected double ratePerHour() {
        return 10;
    }
}

class Car extends Vehicle {
    Car(String regNo) {
        super(regNo);
    }

    @Override
    protected double ratePerHour() {
        return 30;
    }
}

class ElectricCar extends Car implements Chargeable {
    ElectricCar(String regNo) {
        super(regNo);
    }

    @Override
    public double chargingFee(int kWh) {
        return kWh * 12;
    }
}

public class Task08_Polymorphism {
    public static void main(String[] args) {

        Vehicle[] parked = {
            new TwoWheeler("TN01A1"),
            new Car("TN02B2"),
            new ElectricCar("TN03C3")
        };

        System.out.println("=== RUNTIME POLYMORPHISM ===");

        for (Vehicle v : parked) {
            double fee = v.calculateFee(130);

            if (v instanceof Chargeable) {
                fee += ((Chargeable) v).chargingFee(10);
            }

            System.out.println(
                v.getClass().getSimpleName() + " "
                + v.getRegNo() + " -> Rs " + fee
            );
        }

        System.out.println("\n=== COMPILE-TIME POLYMORPHISM ===");

        Vehicle car = new Car("TN04D4");

        System.out.println("Using minutes: Rs "
                + car.calculateFee(130));

        System.out.println("Using time: Rs "
                + car.calculateFee(
                    LocalTime.of(9, 0),
                    LocalTime.of(11, 10)
                ));

        System.out.println("\n=== EQUALITY CHECK ===");

        System.out.println(
            new Car("TN02B2").equals(
                new ElectricCar("TN02B2")
            )
        );
    }
}
