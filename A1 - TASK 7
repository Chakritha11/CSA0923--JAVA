
import java.util.Objects;

abstract class Vehicle {
    private final String regNo;

    Vehicle(String regNo) {
        this.regNo = regNo;
    }

    public final String getRegNo() {
        return regNo;
    }

    public abstract double calculateFee(int hours);

    @Override
    public String toString() {
        return getClass().getSimpleName()
                + " [RegNo=" + regNo + "]";
    }

    @Override
    public boolean equals(Object obj) {
        if (this == obj) return true;

        if (!(obj instanceof Vehicle)) return false;

        Vehicle other = (Vehicle) obj;
        return regNo.equals(other.regNo);
    }

    @Override
    public int hashCode() {
        return Objects.hash(regNo);
    }
}

class TwoWheeler extends Vehicle {
    TwoWheeler(String regNo) {
        super(regNo);
    }

    @Override
    public double calculateFee(int hours) {
        return hours * 10;
    }
}

class Car extends Vehicle {
    Car(String regNo) {
        super(regNo);
    }

    @Override
    public double calculateFee(int hours) {
        return hours * 30;
    }
}

final class ElectricCar extends Car {
    ElectricCar(String regNo) {
        super(regNo);
    }
}

public class Task07_MethodOverriding {
    public static void main(String[] args) {

        Vehicle bike = new TwoWheeler("TN01A1");
        Vehicle car = new Car("TN02B2");
        Vehicle electric = new ElectricCar("TN03C3");

        System.out.println("=== METHOD OVERRIDING ===");
        System.out.println("Bike Fee: Rs "
                + bike.calculateFee(2));
        System.out.println("Car Fee: Rs "
                + car.calculateFee(2));
        System.out.println("Electric Car Fee: Rs "
                + electric.calculateFee(2));

        System.out.println("\n=== toString() ===");
        System.out.println(car);

        System.out.println("\n=== equals() ===");
        Vehicle car2 = new Car("TN02B2");
        System.out.println("Same Registration: "
                + car.equals(car2));

        System.out.println("\n=== hashCode() ===");
        System.out.println("Same Hash Code: "
                + (car.hashCode() == car2.hashCode()));

        System.out.println("\n=== FINAL KEYWORD ===");
        System.out.println("Registration: "
                + car.getRegNo());
        System.out.println("ElectricCar is a final class");
    }
}
